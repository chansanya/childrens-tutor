# 以下模型与绘画配置都可以留空，启动后到 /admin 控制台填写；两边都有时以控制台为准

# ===== 对话模型 =====
# 协议：openai-responses（OpenAI Responses API）或 anthropic（Messages）。Chat Completions（openai）已弃用
PROVIDER=openai-responses
API_KEY=sk-xxx
# 留空则用官方地址；OpenAI 兼容服务通常需要带 /v1，例如 https://api.example.com/v1
BASE_URL=
MODEL=gpt-4o-mini
# 可选：原样合并进请求体的厂商私有参数（JSON 对象）
EXTRA_BODY=

# ===== 审查模型（意图审查 + 输出审查 + 画画提示词）=====
# 务必选快速、非推理模型：审查只允许输出一个单词
# 与对话模型同一厂商：只填 GUARD_MODEL（留空则与 MODEL 相同），其余继承上面的配置
# 不同厂商：填写 GUARD_PROVIDER / GUARD_API_KEY / GUARD_BASE_URL / GUARD_MODEL，任一连接项存在即完全独立，不继承上面的 Key 和地址
GUARD_PROVIDER=
GUARD_API_KEY=
GUARD_BASE_URL=
GUARD_MODEL=
# 混合思考模型须关闭思考，否则 10 个 token 内给不出结论。阿里云示例：{"enable_thinking": false}
GUARD_EXTRA_BODY={"enable_thinking": false}

# 严格模式（默认开启）：输出审查调用失败或无法解析时不放行。设为 false 则放行
GUARD_STRICT=true

# ===== 绘画（ComfyUI）=====
# 填写后默认启用绘画；模板、超时、排队数等在控制台“绘画”菜单中调整
COMFY_URL=

# ===== 日志 =====
# 服务日志级别：debug / info / warn / error，默认 info；控制台"审计"页可在线调整（优先于这里）
# debug 会打印每个阶段（入参审批、意图分析、生成、输出审查、画画），日志中会出现问题的前 40 个字
LOG_LEVEL=

# ===== 数据目录 =====
# 审计日志（logs/）与画画图片（images/）存放位置，默认项目下的 data/
DATA_DIR=
